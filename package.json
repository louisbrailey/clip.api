    "baseline-browser-mapping": "2.11.0",
    "fast-uri": "4.2.3",
    "esbuild": "0.28.2",
    "ws": "8.22.0",
    "undici": "8.12.3",
    "fflate": "0.8.3",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5"
