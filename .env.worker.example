# Copy to .env.worker, restrict file permissions, and fill through your secret manager.
CONSTELLATION_URL=https://your-authenticated-control-endpoint.example
CONSTELLATION_WORKER_KEY=
# Existing Sites machine-access token for this exact portal; separate from its worker key.
SITES_API_TOKEN=
OPENAI_API_KEY=
WORKER_CONCURRENCY=2
# Optional local narration binary; /usr/bin/say on macOS or /usr/bin/espeak-ng in the worker container.
NARRATOR_BIN=
# Optional Cloudflare Access machine credentials for a separately configured proxy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# OAuth app must include youtube.upload and youtube.readonly scopes.
YOUTUBE_AMBIENT={"client_id":"","client_secret":"","refresh_token":""}

# Reddit OAuth app. Use only for accounts you own or are authorized to manage.
# Keep the refresh token in the worker secret store; do not put it in the portal account registry.
REDDIT_AMBIENT={"client_id":"","client_secret":"","refresh_token":"","user_agent":"clip.api/1.0 by YOUR_REDDIT_USERNAME"}

# TikTok requires an approved OAuth app and creator-authorized flow; it is not an API-key-only integration.
# This reference is reserved for the manual creator-review handoff until TikTok approves Direct Post access.
TIKTOK_AMBIENT={"client_key":"","client_secret":"","access_token":""}

# X user OAuth2 PKCE grant: tweet.read tweet.write users.read media.write offline.access.
# Confidential apps include client_secret; public apps omit it.
# Rotated tokens persist under JOURNAL_DIR/credentials; keep that volume private.
X_AMBIENT={"client_id":"","client_secret":"","refresh_token":""}

# Meta user OAuth token with approved Instagram content publishing permission.
# external_id must be the numeric Instagram professional account ID.
INSTAGRAM_AMBIENT={"access_token":""}
# Threads user OAuth token with threads_basic and threads_content_publish.
# external_id must be the numeric Threads account ID. The approved video must be publicly staged on HTTPS.
THREADS_AMBIENT={"access_token":""}
