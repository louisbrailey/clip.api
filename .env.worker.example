# Copy to .env.worker, restrict file permissions, and fill through your secret manager.
CONSTELLATION_URL=https://your-authenticated-control-endpoint.example
CONSTELLATION_WORKER_KEY=
# Existing Sites machine-access token for this exact portal; separate from its worker key.
SITES_API_TOKEN=
OPENAI_API_KEY=
WORKER_CONCURRENCY=2
# Optional Cloudflare Access machine credentials for a separately configured proxy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# OAuth app must include youtube.upload and youtube.readonly scopes.
YOUTUBE_AMBIENT={"client_id":"","client_secret":"","refresh_token":""}

# X user OAuth2 PKCE grant: tweet.read tweet.write users.read media.write offline.access.
# Confidential apps include client_secret; public apps omit it.
# Rotated tokens persist under JOURNAL_DIR/credentials; keep that volume private.
X_AMBIENT={"client_id":"","client_secret":"","refresh_token":""}
