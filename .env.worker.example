# Copy to .env.worker, restrict file permissions, and fill through your secret manager.
CONSTELLATION_URL=https://your-authenticated-control-endpoint.example
CONSTELLATION_WORKER_KEY=
OPENAI_API_KEY=
WORKER_CONCURRENCY=2
# Optional Cloudflare Access machine credentials for a separately configured proxy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# OAuth app must include youtube.upload and youtube.readonly scopes.
YOUTUBE_AMBIENT={"client_id":"","client_secret":"","refresh_token":""}
